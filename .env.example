# Copy this file to  .env  (same folder as server.js), fill in what you have, then restart the server.
# Anything you leave out simply stays switched off.

# ---- Admin account (only used the first time you run: node setup-db.js) ----
ADMIN_PASSWORD=choose-a-strong-password

# ---- Security (important before going live) ----
JWT_SECRET=type-a-long-random-sentence-here

# ---- Online payments (Razorpay). Use rzp_test_ keys first. Leave empty = demo payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- SMS and WhatsApp (Twilio) ----
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
TWILIO_WA_FROM=whatsapp:+1xxxxxxxxxx

# ---- Any other SMS/WhatsApp provider: we POST {to, email, subject, text} as JSON to this URL ----
WEBHOOK_URL=

# ---- Email ----
SMTP_URL=smtps://user:password@smtp.example.com
MAIL_FROM=Groco <orders@yourdomain.com>

# ---- Hosting ----
PORT=3000
# TRUST_PROXY=1            (set when a host / proxy sits in front of the app)
# SSL_KEY=C:\certs\key.pem    SSL_CERT=C:\certs\cert.pem   (only if you want the app itself to serve HTTPS)
